import { ComboBox, LineEdit } from "std-widgets.slint";
import { Theme, Glyphs } from "theme.slint";
import { BodyStrong, Caption, Card, FluentButton, FluentSlider, Glyph, InfoBar, LinkButton, SectionHeader, Segmented, SettingRow, Title, ToggleSwitch } from "controls.slint";

/// A reading on the Monitor page.
export struct Metric {
    icon: string,
    title: string,
    value: string,
    detail: string,
    // Path commands for the last minute, in a 1000 × 1000 view box; empty for none.
    history: string,
    // 0-1 for a bar under the value; below 0 for none.
    level: float,
    warn: bool,
}

/// A step of a fan curve: where it's drawn (0-1 across and up the chart) and its values.
export struct CurvePoint {
    x: float,
    y: float,
    temp: int,
    duty: int,
}

export struct Detail {
    label: string,
    value: string,
}

/// A selectable card with a radio mark, for choices that need a description.
component ChoiceCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> selected;
    in property <bool> enabled: true;
    callback clicked;
    border-radius: 8px;
    background: touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.card-hover : Theme.card;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.card-stroke;
    opacity: root.enabled ? 1 : 0.5;
    min-height: 108px;
    // Cards in a row share its width evenly, however long their text.
    horizontal-stretch: 1;
    preferred-width: 0px;
    animate border-color, background { duration: 120ms; }
    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            Glyph {
                text: root.icon;
                font-size: 20px;
                width: 24px;
                color: root.selected ? Theme.accent : Theme.text;
            }
            BodyStrong {
                text: root.title;
                vertical-alignment: center;
                horizontal-stretch: 1;
                // So the title's length doesn't set the card's width (it fits at any window size the app allows).
                overflow: elide;
            }
            // The radio mark.
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: root.selected ? 0px : 1px;
                border-color: Theme.text-secondary;
                background: root.selected ? Theme.accent : transparent;
                Rectangle {
                    width: root.selected ? 8px : 0px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.on-accent;
                    animate width { duration: 120ms; }
                }
            }
        }
        Caption {
            text: root.description;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A line of a reading's last minute.
component Sparkline inherits Rectangle {
    in property <string> commands;
    in property <color> stroke: Theme.accent;
    if root.commands != "": Path {
        width: root.width;
        height: root.height;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: fill;
        stroke: root.stroke;
        stroke-width: 1.5px;
        commands: root.commands;
    }
}

component MetricCard inherits Rectangle {
    in property <Metric> metric;
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    clip: true;
    // Beside the value, over the right half.
    Sparkline {
        x: parent.width * 0.5;
        y: 44px;
        width: parent.width * 0.5 - 16px;
        height: 52px;
        commands: root.metric.history;
        stroke: (root.metric.warn ? Theme.caution : Theme.accent).transparentize(0.35);
    }
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            Glyph {
                text: root.metric.icon;
                width: 18px;
                font-size: 15px;
                color: Theme.text-secondary;
            }
            Caption {
                text: root.metric.title;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        Text {
            text: root.metric.value;
            font-family: Theme.display-font;
            font-size: 28px;
            font-weight: 600;
            color: root.metric.warn ? Theme.caution : Theme.text;
        }
        Caption {
            text: root.metric.detail;
        }
        if root.metric.level >= 0: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.subtle-selected;
            Rectangle {
                x: 0;
                width: parent.width * Math.clamp(root.metric.level, 0, 1);
                border-radius: 2px;
                background: root.metric.warn ? Theme.caution : Theme.accent;
                animate width { duration: 400ms; }
            }
        }
    }
}

/// Cards in as many columns as fit.
component MetricGrid inherits Rectangle {
    in property <[Metric]> metrics;
    property <length> gap: 12px;
    property <int> columns: self.width > 620px ? 2 : 1;
    property <length> card-width: (self.width - (self.columns - 1) * self.gap) / self.columns;
    property <length> card-height: 148px;
    preferred-height: Math.ceil(root.metrics.length / self.columns) * (self.card-height + self.gap) - self.gap;
    min-height: self.preferred-height;
    for m[i] in root.metrics: MetricCard {
        x: Math.mod(i, root.columns) * (root.card-width + root.gap);
        y: Math.floor(i / root.columns) * (root.card-height + root.gap);
        width: root.card-width;
        height: root.card-height;
        metric: m;
    }
}

/// A fan curve: the duty for each temperature step, with the default curve under it. Points can be dragged up and
/// down; the app keeps them safe and rising.
component FanCurve inherits Rectangle {
    in property <[CurvePoint]> points;
    in property <string> path;
    in property <string> default-path;
    in property <bool> enabled;
    callback duty-changed(int, int);
    property <length> pad-left: 44px;
    property <length> pad-top: 12px;
    property <length> pad-right: 16px;
    property <length> pad-bottom: 28px;
    property <length> plot-width: self.width - self.pad-left - self.pad-right;
    property <length> plot-height: self.height - self.pad-top - self.pad-bottom;
    property <int> active: -1;
    height: 260px;

    // Speed lines and labels.
    for level in [0, 25, 50, 75, 100]: Rectangle {
        x: root.pad-left;
        y: root.pad-top + root.plot-height * (1 - level / 100);
        width: root.plot-width;
        height: 1px;
        background: Theme.divider;
        Text {
            x: -root.pad-left;
            y: -7px;
            width: root.pad-left - 8px;
            text: level + "%";
            font-size: 11px;
            color: Theme.text-tertiary;
            horizontal-alignment: right;
        }
    }
    // Temperature labels, 30-100 °C.
    for t in [30, 40, 50, 60, 70, 80, 90, 100]: Text {
        x: root.pad-left + root.plot-width * (t - 30) / 70 - 20px;
        y: root.pad-top + root.plot-height + 8px;
        width: 40px;
        text: t + " °C";
        font-size: 11px;
        color: Theme.text-tertiary;
        horizontal-alignment: center;
    }
    Path {
        x: root.pad-left;
        y: root.pad-top;
        width: root.plot-width;
        height: root.plot-height;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: fill;
        stroke: Theme.text-tertiary;
        stroke-width: 1px;
        commands: root.default-path;
    }
    Path {
        x: root.pad-left;
        y: root.pad-top;
        width: root.plot-width;
        height: root.plot-height;
        viewbox-width: 1000;
        viewbox-height: 1000;
        fit: fill;
        stroke: root.enabled ? Theme.accent : Theme.text-secondary;
        stroke-width: 2.5px;
        commands: root.path;
    }
    for p[i] in root.points: handle := Rectangle {
        x: root.pad-left + root.plot-width * p.x - 8px;
        y: root.pad-top + root.plot-height * (1 - p.y) - 8px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.enabled ? Theme.accent : Theme.text-secondary;
        border-width: 2px;
        border-color: Theme.card;
        drop-shadow-blur: touch.has-hover || touch.pressed ? 6px : 0px;
        drop-shadow-color: #00000060;
        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: self.enabled ? MouseCursor.ns-resize : MouseCursor.default;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.active = i;
                }
                if (event.kind == PointerEventKind.up) {
                    root.active = -1;
                }
            }
            moved => {
                if (self.pressed) {
                    // The pointer's height in the plot, from the handle's top.
                    root.duty-changed(i, Math.round((1 - (handle.y + self.mouse-y - root.pad-top) / root.plot-height) * 100));
                }
            }
        }
        // The values while pointing at or dragging the point.
        if touch.has-hover || root.active == i: Rectangle {
            x: (parent.width - self.width) / 2;
            y: -34px;
            width: label.preferred-width + 16px;
            height: 26px;
            border-radius: 4px;
            background: Theme.dark ? #2c2c2c : #f9f9f9;
            border-width: 1px;
            border-color: Theme.control-stroke;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000040;
            label := Text {
                text: (i == 0 ? "Below " + root.points[1].temp : p.temp) + " °C · " + p.duty + "%";
                font-size: 12px;
                color: Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

/// The CPU tuning controls, set from Rust; the slider values are separate in-out properties.
export struct TuningView {
    available: bool,
    custom: bool,
    pl-min: int,
    pl1-max: int,
    pl2-max: int,
    pl4-max: int,
    defaults: string,
    tcc-available: bool,
    tcc-on: bool,
    tcc-max: int,
    gpu-available: bool,
    gpu-custom: bool,
    gpu-extra-available: bool,
    gpu-min: int,
    gpu-max: int,
    gpu-defaults: string,
    boost-available: bool,
    boost-on: bool,
    boost-text: string,
    note: string,
    voltage-available: bool,
    voltage-min: int,
    voltage-max: int,
    voltage-saved: int,
    voltage-changed: bool,
    voltage-note: string,
    // What waits for a restart; empty for nothing.
    voltage-restart: string,
}

/// A setting row with a slider and its value.
component SliderRow inherits SettingRow {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in-out property <float> value;
    in property <string> unit;
    in property <bool> signed;
    in property <bool> enabled: true;
    callback changed(float);
    HorizontalLayout {
        spacing: 12px;
        width: 320px;
        FluentSlider {
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            enabled: root.enabled;
            value <=> root.value;
            changed(v) => { root.changed(v); }
        }
        Text {
            text: (root.signed && root.value > 0 ? "+" : "") + Math.round(root.value) + " " + root.unit;
            width: 64px;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: Theme.text-secondary;
        }
    }
}

/// Performance modes, Fan Boost and the fan curve.
export component PerformancePage inherits VerticalLayout {
    in property <bool> available;
    in property <string> note;
    in property <int> mode;
    in property <bool> turbo;
    in property <bool> fan-boost;
    in property <string> limits;
    in property <[Metric]> fans;
    in property <bool> curve-available;
    in property <bool> curve-enabled;
    in property <bool> curve-busy;
    in property <string> curve-note;
    in property <bool> safety;
    in property <int> curve-fan;
    in property <[CurvePoint]> curve;
    in property <string> curve-path;
    in property <string> default-path;
    in property <TuningView> tuning;
    // The GPU mode (MUX switch): 0 Hybrid, 1 integrated graphics only, 2 NVIDIA only.
    in property <bool> gpu-mode-shown;
    in property <bool> gpu-mode-available;
    in-out property <int> gpu-mode;
    in property <string> gpu-mode-note;
    in property <string> gpu-mode-restart;
    in-out property <float> pl1;
    in-out property <float> pl2;
    in-out property <float> pl4;
    in-out property <float> tcc;
    in-out property <float> gpu-tgp;
    in-out property <float> voltage;
    // The current mode's profiles.
    in property <[string]> profile-names;
    in-out property <int> profile-index;
    in property <bool> profile-full;
    in-out property <string> new-profile;
    callback select-profile(int);
    callback add-profile(string);
    callback delete-profile();
    callback set-mode(int);
    callback set-fan-boost(bool);
    callback set-curve-enabled(bool);
    callback select-curve-fan(int);
    callback curve-duty(int, int);
    callback reset-curve();
    // which: 0 PL1, 1 PL2, 2 PL4
    callback set-custom-limits(bool);
    callback limit-changed(int, float);
    callback set-tcc(bool);
    callback tcc-changed(float);
    callback set-gpu-mode(int);
    callback set-custom-gpu(bool);
    callback gpu-changed(float);
    callback set-dynamic-boost(bool);
    callback reset-tuning();
    callback voltage-changed(float);
    callback save-voltage();

    property <[string]> mode-names: ["Office", "Gaming", "Turbo"];
    // The restart notes closed with their ✕; one comes back when its text changes.
    property <string> voltage-restart-closed;
    property <string> gpu-mode-restart-closed;

    spacing: 8px;
    VerticalLayout {
        padding-bottom: 12px;
        spacing: 4px;
        Title {
            text: "Performance";
        }
        Caption {
            text: root.mode-names[root.mode] + " mode" + (root.fan-boost ? " · Fan Boost on" : "") + (root.limits != "" ? " · " + root.limits : "");
        }
    }
    if root.note != "": HorizontalLayout {
        padding-bottom: 8px;
        spacing: 10px;
        Glyph {
            text: Glyphs.info;
            color: Theme.accent;
            width: 16px;
            font-size: 14px;
            vertical-alignment: top;
        }
        Caption {
            text: root.note;
            horizontal-stretch: 1;
        }
    }

    SectionHeader {
        text: "Mode";
    }
    HorizontalLayout {
        spacing: 12px;
        ChoiceCard {
            icon: Glyphs.office;
            title: "Office";
            description: "Quiet and cool, with lower CPU power limits. Good for work and battery life.";
            selected: root.mode == 0;
            enabled: root.available;
            clicked => { root.set-mode(0); }
        }
        ChoiceCard {
            icon: Glyphs.gaming;
            title: "Gaming";
            description: "The laptop's standard balance of performance and fan noise.";
            selected: root.mode == 1;
            enabled: root.available;
            clicked => { root.set-mode(1); }
        }
        if root.turbo: ChoiceCard {
            icon: Glyphs.turbo;
            title: "Turbo";
            description: "The highest power limits, with the fans running faster.";
            selected: root.mode == 2;
            enabled: root.available;
            clicked => { root.set-mode(2); }
        }
    }
    Caption {
        text: "The performance key on the keyboard switches modes too. On battery the laptop sets its own power limits.";
    }

    VerticalLayout {
        padding-top: 20px;
        spacing: 4px;
        SectionHeader {
            text: root.mode-names[root.mode] + " mode profiles";
            height: 28px;
            vertical-alignment: top;
        }
        SettingRow {
            icon: Glyphs.setups;
            title: "Profile";
            description: "Each profile keeps its own CPU and GPU tuning and fan curve; changes below go into the one picked here.";
            ComboBox {
                width: 200px;
                enabled: root.available;
                model: root.profile-names;
                current-index <=> root.profile-index;
                selected => { root.select-profile(self.current-index); }
            }
            if root.profile-index > 0: LinkButton {
                text: "Delete";
                vertical-alignment: center;
                clicked => { root.delete-profile(); }
            }
        }
        SettingRow {
            icon: Glyphs.add;
            title: "New profile";
            description: root.profile-full ? "This mode has five profiles, as many as it can have." : "Starts as a copy of the one picked above.";
            LineEdit {
                width: 200px;
                enabled: root.available && !root.profile-full;
                placeholder-text: "Name, such as Quiet";
                text <=> root.new-profile;
                accepted(text) => {
                    root.add-profile(text);
                    root.new-profile = "";
                }
            }
            FluentButton {
                text: "Add";
                enabled: root.available && !root.profile-full;
                clicked => {
                    root.add-profile(root.new-profile);
                    root.new-profile = "";
                }
            }
        }
    }

    VerticalLayout {
        padding-top: 20px;
        spacing: 4px;
        SectionHeader {
            text: "CPU for " + root.mode-names[root.mode] + " mode";
            height: 28px;
            vertical-alignment: top;
        }
        if root.tuning.note != "": Caption {
            text: root.tuning.note;
        }
        SettingRow {
            icon: Glyphs.chip;
            title: "Custom power limits";
            description: root.tuning.custom ? "Used on the charger in this mode; on battery the laptop sets its own. Each limit is at least the one before it." : root.tuning.defaults;
            ToggleSwitch {
                checked: root.tuning.custom;
                enabled: root.tuning.available;
                toggled(on) => { root.set-custom-limits(on); }
            }
        }
        if root.tuning.custom: SliderRow {
            title: "Sustained (PL1)";
            description: "What the CPU can draw for as long as it runs.";
            minimum: root.tuning.pl-min;
            maximum: root.tuning.pl1-max;
            unit: "W";
            enabled: root.tuning.available;
            value <=> root.pl1;
            changed(v) => { root.limit-changed(0, v); }
        }
        if root.tuning.custom: SliderRow {
            title: "Boost (PL2)";
            description: "What it can draw in bursts, for up to about a minute.";
            minimum: root.tuning.pl-min;
            maximum: root.tuning.pl2-max;
            unit: "W";
            enabled: root.tuning.available;
            value <=> root.pl2;
            changed(v) => { root.limit-changed(1, v); }
        }
        if root.tuning.custom: SliderRow {
            title: "Peak (PL4)";
            description: "The limit it never goes over, even for an instant.";
            minimum: root.tuning.pl-min;
            maximum: root.tuning.pl4-max;
            unit: "W";
            enabled: root.tuning.available;
            value <=> root.pl4;
            changed(v) => { root.limit-changed(2, v); }
        }
        if root.tuning.tcc-available: SettingRow {
            icon: Glyphs.fan;
            title: "TCC offset";
            description: !root.tuning.tcc-on ? "Off: the CPU slows down only at its maximum temperature." : Math.round(root.tcc) == 0 ? "At 0 °C nothing changes yet. Each degree makes the CPU start slowing down that much below its maximum temperature, so it runs cooler." : "The CPU starts slowing down " + Math.round(root.tcc) + " °C below its maximum temperature, so it runs cooler.";
            HorizontalLayout {
                spacing: 12px;
                if root.tuning.tcc-on: FluentSlider {
                    width: 180px;
                    minimum: 0;
                    maximum: root.tuning.tcc-max;
                    value <=> root.tcc;
                    changed(v) => { root.tcc-changed(v); }
                }
                if root.tuning.tcc-on: Text {
                    text: Math.round(root.tcc) + " °C";
                    width: 40px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                }
                ToggleSwitch {
                    checked: root.tuning.tcc-on;
                    enabled: root.tuning.available;
                    toggled(on) => { root.set-tcc(on); }
                }
            }
        }
        SettingRow {
            icon: Glyphs.turbo;
            title: "Core voltage offset (all modes)";
            description: root.tuning.voltage-note;
            HorizontalLayout {
                spacing: 12px;
                width: 400px;
                FluentSlider {
                    minimum: root.tuning.voltage-min;
                    maximum: root.tuning.voltage-max;
                    step: 5;
                    enabled: root.tuning.voltage-available;
                    value <=> root.voltage;
                    changed(v) => { root.voltage-changed(v); }
                }
                Text {
                    text: (root.voltage > 0 ? "+" : "") + Math.round(root.voltage) + " mV";
                    width: 64px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    color: Theme.text-secondary;
                }
                FluentButton {
                    text: "Save to BIOS";
                    icon: Glyphs.save;
                    enabled: root.tuning.voltage-available && root.tuning.voltage-changed;
                    clicked => { root.save-voltage(); }
                }
            }
        }
        if root.tuning.voltage-restart != "" && root.tuning.voltage-restart != root.voltage-restart-closed: InfoBar {
            caution: true;
            message: root.tuning.voltage-restart;
            closable: true;
            closed => { root.voltage-restart-closed = root.tuning.voltage-restart; }
        }
    }

    if root.tuning.gpu-available || root.gpu-mode-shown: VerticalLayout {
        padding-top: 20px;
        spacing: 4px;
        SectionHeader {
            text: root.tuning.gpu-available ? "GPU for " + root.mode-names[root.mode] + " mode" : "GPU";
            height: 28px;
            vertical-alignment: top;
        }
        if root.tuning.gpu-available && root.tuning.gpu-extra-available: SettingRow {
            icon: Glyphs.display;
            title: "GPU power limit";
            description: root.tuning.gpu-custom ? "Used on the charger in this mode; on battery the laptop picks it." : root.tuning.gpu-defaults;
            ToggleSwitch {
                checked: root.tuning.gpu-custom;
                enabled: root.tuning.available;
                toggled(on) => { root.set-custom-gpu(on); }
            }
        }
        if root.tuning.gpu-available && root.tuning.gpu-custom: SliderRow {
            title: "GPU power (TGP)";
            description: "What the GPU can draw for as long as it runs, before Dynamic Boost.";
            minimum: root.tuning.gpu-min;
            maximum: root.tuning.gpu-max;
            unit: "W";
            enabled: root.tuning.available;
            value <=> root.gpu-tgp;
            changed(v) => { root.gpu-changed(v); }
        }
        if root.tuning.gpu-available && root.tuning.boost-available: SettingRow {
            icon: Glyphs.performance;
            title: "Dynamic Boost";
            description: root.tuning.boost-text;
            ToggleSwitch {
                checked: root.tuning.boost-on;
                enabled: root.tuning.available;
                toggled(on) => { root.set-dynamic-boost(on); }
            }
        }
        if root.gpu-mode-shown: SettingRow {
            icon: Glyphs.display;
            title: "GPU mode (all modes)";
            description: root.gpu-mode-note;
            ComboBox {
                width: 220px;
                model: ["Hybrid (MSHybrid)", "Integrated graphics only", "NVIDIA graphics only"];
                enabled: root.gpu-mode-available;
                current-index <=> root.gpu-mode;
                selected => { root.set-gpu-mode(self.current-index); }
            }
        }
        if root.gpu-mode-restart != "" && root.gpu-mode-restart != root.gpu-mode-restart-closed: InfoBar {
            caution: true;
            message: root.gpu-mode-restart;
            closable: true;
            closed => { root.gpu-mode-restart-closed = root.gpu-mode-restart; }
        }
    }

    VerticalLayout {
        padding-top: 12px;
        HorizontalLayout {
            spacing: 10px;
            Glyph {
                text: Glyphs.warning;
                color: Theme.caution;
                width: 16px;
                font-size: 14px;
                vertical-alignment: top;
            }
            Caption {
                text: "Higher limits make the laptop hotter and louder. A voltage offset can make Windows crash or the laptop fail to start; if it fails to start, the BIOS starts without the tuning next time, and this app then sets everything here back to the defaults.";
                horizontal-stretch: 1;
            }
            LinkButton {
                text: "Reset this mode";
                vertical-alignment: top;
                clicked => { root.reset-tuning(); }
            }
        }
    }

    VerticalLayout {
        padding-top: 20px;
        spacing: 4px;
        SectionHeader {
            text: "Fans";
            height: 28px;
            vertical-alignment: top;
        }
        SettingRow {
            icon: Glyphs.fan;
            title: "Fan Boost";
            description: "Runs the fans at full speed for the most cooling, whatever the temperature. The Fan Boost key turns it on and off too.";
            ToggleSwitch {
                checked: root.fan-boost;
                enabled: root.available;
                toggled(on) => { root.set-fan-boost(on); }
            }
        }
        HorizontalLayout {
            padding-top: 4px;
            spacing: 12px;
            for m in root.fans: MetricCard {
                height: 120px;
                metric: m;
            }
        }
    }

    VerticalLayout {
        padding-top: 20px;
        spacing: 8px;
        SectionHeader {
            text: "Fan curve for " + root.mode-names[root.mode] + " mode";
        }
        Card {
            opacity: root.curve-available ? 1 : 0.6;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: "Custom fan curve";
                            color: Theme.text;
                        }
                        Caption {
                            text: root.curve-note != "" ? root.curve-note : root.curve-enabled ? "The fans follow your curve in " + root.mode-names[root.mode] + " mode." : "Off: the fans follow the laptop's own curve for this mode, shown here.";
                        }
                    }
                    Segmented {
                        width: 240px;
                        options: ["CPU fan", "GPU fan"];
                        selected: root.curve-fan;
                        changed(i) => { root.select-curve-fan(i); }
                    }
                    ToggleSwitch {
                        checked: root.curve-enabled;
                        enabled: root.curve-available && root.available && !root.curve-busy && !root.safety;
                        toggled(on) => { root.set-curve-enabled(on); }
                    }
                }
                if root.safety: HorizontalLayout {
                    spacing: 10px;
                    Glyph {
                        text: Glyphs.warning;
                        color: Theme.caution;
                        width: 16px;
                        font-size: 14px;
                    }
                    Caption {
                        text: "The laptop's fan safety protection is on, so the fans follow its own curve until it turns off.";
                        horizontal-stretch: 1;
                    }
                }
                FanCurve {
                    points: root.curve;
                    path: root.curve-path;
                    default-path: root.default-path;
                    enabled: root.curve-enabled && root.available && !root.curve-busy;
                    duty-changed(i, duty) => { root.curve-duty(i, duty); }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Caption {
                        text: "Drag a point to set the fan speed from that temperature on; the thin line is the laptop's curve. Speeds stay at most 30% below it, and at or above it from 75 °C, so the laptop is always cooled enough.";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    LinkButton {
                        text: "Reset to default";
                        vertical-alignment: center;
                        clicked => { root.reset-curve(); }
                    }
                }
            }
        }
    }
}

/// Battery care and the battery's state.
/// The Performance or Battery page when the embedded controller can't be used at all: why, and how to fix it.
export component EcUnavailablePage inherits VerticalLayout {
    in property <string> title;
    in property <string> message;
    callback open-setup();

    spacing: 8px;
    alignment: start;
    VerticalLayout {
        padding-bottom: 12px;
        Title {
            text: root.title;
        }
    }
    InfoBar {
        message: root.message;
        caution: true;
        action: "Linux setup";
        action-clicked => { root.open-setup(); }
    }
}

export component BatteryPage inherits VerticalLayout {
    in property <bool> available;
    in property <string> note;
    in property <int> charge-mode;
    in property <int> percent;
    in property <string> state;
    in property <[Detail]> details;
    in property <bool> usb-supported;
    in property <bool> usb-power;
    callback set-charge-mode(int);
    callback set-usb-power(bool);

    spacing: 8px;
    VerticalLayout {
        padding-bottom: 12px;
        Title {
            text: "Battery";
        }
    }

    Card {
        HorizontalLayout {
            padding: 20px;
            spacing: 24px;
            // A battery drawing filled to the charge.
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    width: 120px;
                    height: 56px;
                    Rectangle {
                        x: 0;
                        width: 112px;
                        border-radius: 8px;
                        border-width: 2px;
                        border-color: Theme.text-secondary;
                        Rectangle {
                            x: 5px;
                            y: 5px;
                            height: parent.height - 10px;
                            width: (parent.width - 10px) * Math.clamp(root.percent / 100, 0, 1);
                            border-radius: 4px;
                            background: root.percent <= 15 ? Theme.critical : Theme.accent;
                            animate width { duration: 400ms; }
                        }
                    }
                    Rectangle {
                        x: 114px;
                        y: 18px;
                        width: 6px;
                        height: 20px;
                        border-radius: 2px;
                        background: Theme.text-secondary;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: root.percent < 0 ? "No battery" : root.percent + "%";
                    font-family: Theme.display-font;
                    font-size: 34px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Caption {
                    text: root.state;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                for d in root.details: HorizontalLayout {
                    spacing: 16px;
                    Caption {
                        text: d.label;
                        width: 140px;
                    }
                    Text {
                        text: d.value;
                        color: Theme.text;
                        font-size: 12px;
                        min-width: 120px;
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding-top: 20px;
        spacing: 8px;
        SectionHeader {
            text: "Battery care";
        }
        if root.note != "": Caption {
            text: root.note;
        }
        HorizontalLayout {
            spacing: 12px;
            ChoiceCard {
                icon: Glyphs.battery;
                title: "High capacity";
                description: "Charges fully. Best when you often use the laptop on battery.";
                selected: root.charge-mode == 0;
                enabled: root.available;
                clicked => { root.set-charge-mode(0); }
            }
            ChoiceCard {
                icon: Glyphs.battery;
                title: "Balanced";
                description: "A balance between battery time and battery wear.";
                selected: root.charge-mode == 1;
                enabled: root.available;
                clicked => { root.set-charge-mode(1); }
            }
            ChoiceCard {
                icon: Glyphs.plug;
                title: "Stationary";
                description: "Keeps the charge around 40% to 60%, for a laptop that's nearly always plugged in.";
                selected: root.charge-mode == 2;
                enabled: root.available;
                clicked => { root.set-charge-mode(2); }
            }
        }
        Caption {
            text: "Kept by the laptop itself, also when this app isn't running. Charging stops early in Balanced and Stationary, which slows the battery's wear.";
        }
    }

    if root.usb-supported: VerticalLayout {
        padding-top: 20px;
        spacing: 4px;
        SectionHeader {
            text: "While the laptop is off";
            height: 28px;
            vertical-alignment: top;
        }
        SettingRow {
            icon: Glyphs.plug;
            title: "Charge devices over USB";
            description: "USB ports keep powering phones and other devices while the laptop is off or asleep. On battery this drains it.";
            ToggleSwitch {
                checked: root.usb-power;
                enabled: root.available;
                toggled(on) => { root.set-usb-power(on); }
            }
        }
    }
}

/// Temperatures, loads and fan speeds, live.
export component MonitorPage inherits VerticalLayout {
    in property <[Metric]> metrics;
    in property <string> note;

    spacing: 8px;
    VerticalLayout {
        padding-bottom: 12px;
        spacing: 4px;
        Title {
            text: "Monitor";
        }
        Caption {
            text: root.note != "" ? root.note : "Updated every second while this page is open. The lines show the last minute.";
        }
    }
    MetricGrid {
        metrics: root.metrics;
    }
}
