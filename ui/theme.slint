    out property <string> plugin: Platform.linux ? "\u{E9E9}" : "\u{EA86}";
    out property <string> setups: Platform.linux ? "\u{E762}" : "\u{E8F1}";
    out property <string> app: Platform.linux ? "\u{E05C}" : "\u{ECAA}";
    out property <string> play: Platform.linux ? "\u{F605}" : "\u{E768}";
    out property <string> display: Platform.linux ? "\u{F359}" : "\u{E7F4}";
    out property <string> menu: Platform.linux ? "\u{F560}" : "\u{E700}";
    out property <string> contrast: Platform.linux ? "\u{E452}" : "\u{E793}";
}
