    out property <string> plug: Platform.linux ? "\u{E999}" : "\u{E83E}";
    out property <string> monitor: Platform.linux ? "\u{E9DC}" : "\u{E9D9}";
    out property <string> fan: Platform.linux ? "\u{F89E}" : "\u{E9CA}";
    out property <string> office: Platform.linux ? "\u{F1FC}" : "\u{E821}";
