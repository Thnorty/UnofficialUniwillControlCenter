import { ScrollView, Palette } from "std-widgets.slint";
import { Theme, Glyphs } from "theme.slint";
import { Glyph, InfoBar } from "controls.slint";
import { KeyCap } from "preview.slint";
import { ColorPicker } from "picker.slint";
import { DeviceView, TileGroup, LightingPage, AlertsPage, SettingsPage } from "pages.slint";
import { Metric, CurvePoint, Detail, TuningView, PerformancePage, BatteryPage, MonitorPage } from "power.slint";
import { PluginSettingView, PluginActionView, PluginView, PluginsPage } from "plugins.slint";
import { SetupView, AppProfileView, SetupsPage } from "setups.slint";
import { DisplayPage } from "display.slint";

export { Theme, KeyCap, DeviceView, TileGroup, Metric, CurvePoint, Detail }

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> selected;
    // Only the icon, in the collapsed pane; the label is then its tooltip.
    in property <bool> compact;
    callback clicked;
    callback hovered(bool);
    height: 40px;
    clip: true;
    border-radius: 4px;
    background: root.selected ? Theme.subtle-selected : touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.subtle-hover : transparent;
    animate background { duration: 100ms; }
    // The accent pill of the selected page.
    Rectangle {
        x: 0;
        width: 3px;
        height: root.selected ? (touch.pressed ? 10px : 16px) : 0px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
        animate height { duration: 180ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 16px;
        Glyph {
            text: root.icon;
            width: 16px;
        }
        if !root.compact: Text {
            text: root.label;
            vertical-alignment: center;
            color: Theme.text;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

export component AppWindow inherits Window {
    title: "Unofficial Uniwill Control Center";
    icon: @image-url("../res/app.png");
    preferred-width: 1100px;
    preferred-height: 800px;
    min-width: 880px;
    min-height: 600px;
    background: Theme.window;
    default-font-family: Theme.font;
    default-font-size: 14px;

    in property <bool> dark-mode: true;
    in-out property <int> page: 0;

    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    in property <bool> has-light-bar;
    in property <string> status-text;
    in property <bool> status-error;
    in property <bool> show-retry;
    in property <[color]> presets;

    // The keyboard.
    in property <DeviceView> kb-view;
    in property <[string]> kb-tiles;
    in property <[TileGroup]> kb-groups;
    in property <[color]> kb-tile-leds;
    in property <[color]> kb-zones;
    in property <[color]> kb-palette;
    in property <[color]> kb-glow;
    in property <[KeyCap]> keys;
    in-out property <float> kb-light;
    in-out property <float> kb-speed;
    in property <string> kb-startup;

    // The light bar.
    in property <DeviceView> lb-view;
    in property <[string]> lb-tiles;
    in property <[TileGroup]> lb-groups;
    in property <[color]> lb-tile-leds;
    in property <[color]> lb-palette;
    in property <[color]> lb-leds;
    in-out property <float> lb-light;
    in-out property <float> lb-speed;
    in property <string> lb-startup;
    in property <bool> startup-available;

    // Timer & alerts.
    in property <bool> timer-running;
    in property <string> timer-left;
    in property <float> timer-progress;
    in-out property <int> timer-minutes: 25;
    in property <bool> flash-caps;
    in property <bool> flash-num;
    in property <bool> popup-caps;
    in property <bool> popup-num;

    // Settings.
    in property <[string]> idle-options;
    in-out property <int> idle-index;
    in property <int> touchpad-state;
    in property <bool> winkey-available;
    in property <bool> winkey-locked;
    in property <bool> start-with-windows;
    in property <bool> show-in-tray: true;
    in property <string> version;
    in property <string> about;
    in property <string> fn-keys;

    // Performance.
    in property <bool> perf-available;
    in property <string> perf-note;
    in property <int> perf-mode: 1;
    in property <bool> perf-turbo;
    in property <bool> fan-boost;
    in property <string> perf-limits;
    in property <[Metric]> fan-metrics;
    in property <bool> curve-available;
    in property <bool> curve-enabled;
    in property <bool> curve-busy;
    in property <string> curve-note;
    in property <bool> fan-safety;
    in property <int> curve-fan;
    in property <[CurvePoint]> curve;
    in property <string> curve-path;
    in property <string> default-path;
    in property <TuningView> tuning;
    in-out property <float> tune-pl1;
    in-out property <float> tune-pl2;
    in-out property <float> tune-pl4;
    in-out property <float> tune-tcc;
    in-out property <float> tune-voltage;

    // Battery.
    in property <bool> battery-available;
    in property <string> battery-note;
    in property <int> charge-mode;
    in property <bool> usb-supported;
    in property <bool> usb-power;
    in property <int> battery-percent: -1;
    in property <string> battery-state;
    in property <[Detail]> battery-details;

    // Monitor.
    in property <[Metric]> metrics;
    in property <string> monitor-note;

    // Plugins.
    in property <[PluginView]> plugins;
    in property <string> plugins-note;
    // Performance profiles.
    in property <[string]> profile-names;
    in-out property <int> profile-index;
    in property <bool> profile-full;
    callback select-profile(int);
    callback add-profile(string);
    callback delete-profile();
    // Display.
    in property <bool> display-demo;
    in property <bool> display-on;
    in property <int> display-mode;
    in property <bool> display-changed;
    in-out property <float> display-saturation;
    in-out property <float> display-contrast;
    in-out property <float> display-temperature;
    in-out property <float> display-red;
    in-out property <float> display-green;
    in-out property <float> display-blue;
    // Setups.
    in property <[SetupView]> setups;
    in property <[string]> setup-names;
    in property <[AppProfileView]> app-profiles;
    in property <bool> app-profiles-on;
    in property <string> app-profile-status;
    // How far a page of repeated rows reaches past its reported height (see PluginsPage).
    property <length> page-overflow;
    // The navigation pane shows only its icons.
    in-out property <bool> nav-collapsed;
    callback nav-collapsed-changed(bool);
    // The collapsed pane's tooltip: which item's name, and where.
    property <string> tip;
    property <length> tip-y;

    function show-tip(on: bool, text: string, y: length) {
        if (on) {
            root.tip = text;
            root.tip-y = y;
        } else if (root.tip == text) {
            root.tip = "";
        }
    }

    // device: 0 = keyboard, 1 = light bar
    callback select-effect(int, int);
    callback light-changed(int, float);
    callback speed-changed(int, float);
    callback direction-changed(int, int);
    callback set-on(bool);
    callback set-linked(bool);
    // device, target (0 = zone, 1 = palette color, 2 = all zones), index, color
    callback color-edited(int, int, int, color);
    // Adds a color to a palette and returns its index.
    callback add-color(int) -> int;
    callback remove-color(int, int);
    callback reset-palette(int);
    callback start-timer(int);
    callback cancel-timer();
    callback set-flash-caps(bool);
    callback set-flash-num(bool);
    callback set-popup-caps(bool);
    callback set-popup-num(bool);
    callback set-idle(int);
    callback toggle-touchpad();
    callback toggle-winkey();
    callback set-start-with-windows(bool);
    callback set-show-in-tray(bool);
    callback exit-app();
    callback retry();
    callback set-mode(int);
    callback set-fan-boost(bool);
    callback set-curve-enabled(bool);
    callback select-curve-fan(int);
    callback curve-duty(int, int);
    callback reset-curve();
    callback set-custom-limits(bool);
    callback limit-changed(int, float);
    callback set-tcc(bool);
    callback tcc-changed(float);
    callback reset-tuning();
    callback voltage-changed(float);
    callback save-voltage();
    callback save-startup(int);
    callback reset-startup(int);
    callback set-charge-mode(int);
    callback set-usb-power(bool);
    callback export-settings();
    callback import-settings();
    callback save-setup(string);
    callback apply-setup(int);
    callback update-setup(int);
    callback delete-setup(int);
    callback add-app-profile();
    callback remove-app-profile(int);
    callback set-app-profile-setup(int, int);
    callback set-app-profiles-on(bool);
    callback set-display-on(bool);
    callback set-display-mode(int);
    callback set-display-value(int, float);
    callback reset-display-mode();
    callback plugin-toggled(string, bool);
    callback plugin-expand(string);
    callback plugin-action(string, string);
    callback plugin-remove(string);
    callback plugin-reset(string);
    callback plugin-bool(string, string, bool);
    callback plugin-number(string, string, float);
    callback plugin-text(string, string, string);
    callback plugin-choice(string, string, int);
    callback import-plugin();
    callback open-plugins-folder();
    pure callback format-hex(color) -> string;
    pure callback parse-hex(string) -> color;

    property <int> picker-device;
    property <int> picker-target;
    property <int> picker-index;
    property <length> picker-x;
    property <length> picker-y;
    property <color> picker-color;

    function open-picker(device: int, target: int, index: int, c: color, x: length, y: length) {
        root.picker-device = device;
        root.picker-target = target;
        root.picker-index = index;
        root.picker-x = x;
        root.picker-y = y;
        root.picker-color = c;
        picker-popup.show();
    }

    HorizontalLayout {
        // The navigation pane; collapsed, only its icons.
        Rectangle {
            width: root.nav-collapsed ? 60px : 260px;
            animate width { duration: 200ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
            clip: true;
        VerticalLayout {
            padding: 6px;
            padding-top: 8px;
            spacing: 4px;
            HorizontalLayout {
                padding-bottom: 10px;
                spacing: 8px;
                NavItem {
                    width: 48px;
                    icon: Glyphs.menu;
                    label: "Show the menu";
                    compact: true;
                    clicked => {
                        root.nav-collapsed = !root.nav-collapsed;
                        root.tip = "";
                        root.nav-collapsed-changed(root.nav-collapsed);
                    }
                    hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                }
                if !root.nav-collapsed: VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../res/app.png");
                        width: 20px;
                        height: 20px;
                    }
                }
                if !root.nav-collapsed: VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Unofficial";
                        font-size: 10px;
                        color: Theme.text-secondary;
                    }
                    Text {
                        text: "Uniwill Control Center";
                        font-size: 12px;
                        color: Theme.text;
                    }
                }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.keyboard;
                label: "Keyboard";
                selected: root.page == 0;
                clicked => { root.page = 0; }
            }
            if root.has-light-bar: NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.light;
                label: "Light bar";
                selected: root.page == 1;
                clicked => { root.page = 1; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.display;
                label: "Display";
                selected: root.page == 9;
                clicked => { root.page = 9; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.performance;
                label: "Performance";
                selected: root.page == 4;
                clicked => { root.page = 4; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.battery;
                label: "Battery";
                selected: root.page == 5;
                clicked => { root.page = 5; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.monitor;
                label: "Monitor";
                selected: root.page == 6;
                clicked => { root.page = 6; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.timer;
                label: "Timer & alerts";
                selected: root.page == 2;
                clicked => { root.page = 2; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.setups;
                label: "Setups";
                selected: root.page == 8;
                clicked => { root.page = 8; }
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.plugin;
                label: "Plugins";
                selected: root.page == 7;
                clicked => { root.page = 7; }
            }
            Rectangle {
                vertical-stretch: 1;
            }
            NavItem {
                compact: root.nav-collapsed;
                hovered(on) => { root.show-tip(on, self.label, self.absolute-position.y); }
                icon: Glyphs.settings;
                label: "Settings";
                selected: root.page == 3;
                clicked => { root.page = 3; }
            }
        }
        }

        // The content, on a layer with a rounded corner like Windows 11 apps.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.dark ? #272727 : #f9f9f9;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Theme.card-stroke;
            clip: true;
            scroll := ScrollView {
                property <length> side: Math.max(36px, (self.visible-width - 1000px) / 2);
                content-width: self.visible-width;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    width: scroll.visible-width;
                    padding-left: scroll.side;
                    padding-right: scroll.side;
                    padding-top: 28px;
                    padding-bottom: 36px + (root.page == 7 || root.page == 8 ? root.page-overflow : 0px);
                    spacing: 16px;
                    if root.status-text != "": InfoBar {
                        message: root.status-text;
                        critical: root.status-error;
                        action: root.show-retry ? "Retry" : "";
                        action-clicked => { root.retry(); }
                    }
                    if root.page == 0: LightingPage {
                        is-light-bar: false;
                        view: root.kb-view;
                        tiles: root.kb-tiles;
                        groups: root.kb-groups;
                        tile-leds: root.kb-tile-leds;
                        zones: root.kb-zones;
                        palette: root.kb-palette;
                        presets: root.presets;
                        preview: root.kb-glow;
                        keys: root.keys;
                        light <=> root.kb-light;
                        speed <=> root.kb-speed;
                        select-effect(i) => { root.select-effect(0, i); }
                        light-changed(v) => { root.light-changed(0, v); }
                        speed-changed(v) => { root.speed-changed(0, v); }
                        direction-changed(i) => { root.direction-changed(0, i); }
                        edit-color(target, index, c, x, y) => { root.open-picker(0, target, index, c, x, y); }
                        add-color => {
                            let index = root.add-color(0);
                            root.open-picker(0, 1, index, root.kb-palette[index], 240px, 360px);
                        }
                        remove-color(i) => { root.remove-color(0, i); }
                        reset-palette => { root.reset-palette(0); }
                        set-all-zones(c) => { root.color-edited(0, 2, 0, c); }
                        startup: root.kb-startup;
                        startup-available: root.startup-available;
                        save-startup => { root.save-startup(0); }
                        reset-startup => { root.reset-startup(0); }
                    }
                    if root.page == 1: LightingPage {
                        is-light-bar: true;
                        view: root.lb-view;
                        tiles: root.lb-tiles;
                        groups: root.lb-groups;
                        tile-leds: root.lb-tile-leds;
                        palette: root.lb-palette;
                        presets: root.presets;
                        preview: root.lb-leds;
                        light <=> root.lb-light;
                        speed <=> root.lb-speed;
                        select-effect(i) => { root.select-effect(1, i); }
                        light-changed(v) => { root.light-changed(1, v); }
                        speed-changed(v) => { root.speed-changed(1, v); }
                        direction-changed(i) => { root.direction-changed(1, i); }
                        set-on(on) => { root.set-on(on); }
                        set-linked(on) => { root.set-linked(on); }
                        edit-color(target, index, c, x, y) => { root.open-picker(1, target, index, c, x, y); }
                        add-color => {
                            let index = root.add-color(1);
                            root.open-picker(1, 1, index, root.lb-palette[index], 240px, 400px);
                        }
                        remove-color(i) => { root.remove-color(1, i); }
                        reset-palette => { root.reset-palette(1); }
                        startup: root.lb-startup;
                        startup-available: root.startup-available;
                        save-startup => { root.save-startup(1); }
                        reset-startup => { root.reset-startup(1); }
                    }
                    if root.page == 2: AlertsPage {
                        has-light-bar: root.has-light-bar;
                        timer-running: root.timer-running;
                        timer-left: root.timer-left;
                        timer-progress: root.timer-progress;
                        timer-minutes <=> root.timer-minutes;
                        flash-caps: root.flash-caps;
                        flash-num: root.flash-num;
                        popup-caps: root.popup-caps;
                        popup-num: root.popup-num;
                        start-timer(m) => { root.start-timer(m); }
                        cancel-timer => { root.cancel-timer(); }
                        set-flash-caps(on) => { root.set-flash-caps(on); }
                        set-flash-num(on) => { root.set-flash-num(on); }
                        set-popup-caps(on) => { root.set-popup-caps(on); }
                        set-popup-num(on) => { root.set-popup-num(on); }
                    }
                    if root.page == 4: PerformancePage {
                        available: root.perf-available;
                        note: root.perf-note;
                        mode: root.perf-mode;
                        turbo: root.perf-turbo;
                        fan-boost: root.fan-boost;
                        limits: root.perf-limits;
                        fans: root.fan-metrics;
                        curve-available: root.curve-available;
                        curve-enabled: root.curve-enabled;
                        curve-busy: root.curve-busy;
                        curve-note: root.curve-note;
                        safety: root.fan-safety;
                        curve-fan: root.curve-fan;
                        curve: root.curve;
                        curve-path: root.curve-path;
                        default-path: root.default-path;
                        set-mode(m) => { root.set-mode(m); }
                        set-fan-boost(on) => { root.set-fan-boost(on); }
                        set-curve-enabled(on) => { root.set-curve-enabled(on); }
                        select-curve-fan(i) => { root.select-curve-fan(i); }
                        curve-duty(i, duty) => { root.curve-duty(i, duty); }
                        reset-curve => { root.reset-curve(); }
                        tuning: root.tuning;
                        pl1 <=> root.tune-pl1;
                        pl2 <=> root.tune-pl2;
                        pl4 <=> root.tune-pl4;
                        tcc <=> root.tune-tcc;
                        voltage <=> root.tune-voltage;
                        set-custom-limits(on) => { root.set-custom-limits(on); }
                        limit-changed(i, v) => { root.limit-changed(i, v); }
                        set-tcc(on) => { root.set-tcc(on); }
                        tcc-changed(v) => { root.tcc-changed(v); }
                        reset-tuning => { root.reset-tuning(); }
                        voltage-changed(v) => { root.voltage-changed(v); }
                        save-voltage => { root.save-voltage(); }
                        profile-names: root.profile-names;
                        profile-index <=> root.profile-index;
                        profile-full: root.profile-full;
                        select-profile(i) => { root.select-profile(i); }
                        add-profile(name) => { root.add-profile(name); }
                        delete-profile => { root.delete-profile(); }
                    }
                    if root.page == 5: BatteryPage {
                        available: root.battery-available;
                        note: root.battery-note;
                        charge-mode: root.charge-mode;
                        percent: root.battery-percent;
                        state: root.battery-state;
                        details: root.battery-details;
                        usb-supported: root.usb-supported;
                        usb-power: root.usb-power;
                        set-charge-mode(m) => { root.set-charge-mode(m); }
                        set-usb-power(on) => { root.set-usb-power(on); }
                    }
                    if root.page == 6: MonitorPage {
                        metrics: root.metrics;
                        note: root.monitor-note;
                    }
                    if root.page == 9: DisplayPage {
                        demo: root.display-demo;
                        on: root.display-on;
                        mode: root.display-mode;
                        changed: root.display-changed;
                        saturation <=> root.display-saturation;
                        contrast <=> root.display-contrast;
                        temperature <=> root.display-temperature;
                        red <=> root.display-red;
                        green <=> root.display-green;
                        blue <=> root.display-blue;
                        set-on(on) => { root.set-display-on(on); }
                        set-mode(i) => { root.set-display-mode(i); }
                        set-value(which, v) => { root.set-display-value(which, v); }
                        reset => { root.reset-display-mode(); }
                    }
                    if root.page == 8: SetupsPage {
                        setups: root.setups;
                        setup-names: root.setup-names;
                        profiles: root.app-profiles;
                        profiles-on: root.app-profiles-on;
                        profile-status: root.app-profile-status;
                        available-width: scroll.visible-width - 2 * scroll.side;
                        init => { root.page-overflow = self.overflow; }
                        changed overflow => { root.page-overflow = self.overflow; }
                        save-setup(name) => { root.save-setup(name); }
                        apply-setup(i) => { root.apply-setup(i); }
                        update-setup(i) => { root.update-setup(i); }
                        delete-setup(i) => { root.delete-setup(i); }
                        add-profile => { root.add-app-profile(); }
                        remove-profile(i) => { root.remove-app-profile(i); }
                        set-profile-setup(i, s) => { root.set-app-profile-setup(i, s); }
                        set-profiles-on(on) => { root.set-app-profiles-on(on); }
                    }
                    if root.page == 7: PluginsPage {
                        plugins: root.plugins;
                        note: root.plugins-note;
                        available-width: scroll.visible-width - 2 * scroll.side;
                        init => { root.page-overflow = self.overflow; }
                        changed overflow => { root.page-overflow = self.overflow; }
                        toggled(id, on) => { root.plugin-toggled(id, on); }
                        expand(id) => { root.plugin-expand(id); }
                        action(id, a) => { root.plugin-action(id, a); }
                        remove(id) => { root.plugin-remove(id); }
                        reset(id) => { root.plugin-reset(id); }
                        bool-changed(id, key, on) => { root.plugin-bool(id, key, on); }
                        number-changed(id, key, v) => { root.plugin-number(id, key, v); }
                        text-changed(id, key, t) => { root.plugin-text(id, key, t); }
                        choice-changed(id, key, c) => { root.plugin-choice(id, key, c); }
                        pick-color(p, s, c, x, y) => { root.open-picker(2, p, s, c, x, y); }
                        import => { root.import-plugin(); }
                        open-folder => { root.open-plugins-folder(); }
                    }
                    if root.page == 3: SettingsPage {
                        idle-options: root.idle-options;
                        idle-index <=> root.idle-index;
                        touchpad-state: root.touchpad-state;
                        winkey-available: root.winkey-available;
                        winkey-locked: root.winkey-locked;
                        start-with-windows: root.start-with-windows;
                        show-in-tray: root.show-in-tray;
                        version: root.version;
                        about: root.about;
                        fn-keys: root.fn-keys;
                        set-idle(i) => { root.set-idle(i); }
                        toggle-touchpad => { root.toggle-touchpad(); }
                        toggle-winkey => { root.toggle-winkey(); }
                        set-start-with-windows(on) => { root.set-start-with-windows(on); }
                        set-show-in-tray(on) => { root.set-show-in-tray(on); }
                        exit-app => { root.exit-app(); }
                        export-settings => { root.export-settings(); }
                        import-settings => { root.import-settings(); }
                    }
                }
            }
        }
    }

    if root.nav-collapsed && root.tip != "": Rectangle {
        x: 64px;
        y: root.tip-y + 4px;
        width: tip-text.preferred-width + 20px;
        height: 32px;
        border-radius: 4px;
        background: Theme.dark ? #2c2c2c : #f9f9f9;
        border-width: 1px;
        border-color: Theme.card-stroke;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000050;
        tip-text := Text {
            text: root.tip;
            font-size: 12px;
            color: Theme.text;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    picker-popup := PopupWindow {
        x: Math.clamp(root.picker-x, 8px, root.width - 304px);
        y: Math.clamp(root.picker-y, 8px, Math.max(8px, root.height - picker.height - 8px));
        width: picker.width;
        height: picker.height;
        close-policy: close-on-click-outside;
        picker := ColorPicker {
            initial: root.picker-color;
            presets: root.presets;
            format-hex(c) => { return root.format-hex(c); }
            parse-hex(text) => { return root.parse-hex(text); }
            edited(c) => { root.color-edited(root.picker-device, root.picker-target, root.picker-index, c); }
            done => { picker-popup.close(); }
        }
    }
}
