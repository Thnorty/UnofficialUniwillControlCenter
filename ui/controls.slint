import { Theme, Glyphs } from "theme.slint";

export component Glyph inherits Text {
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.text;
    horizontal-alignment: center;
    vertical-alignment: center;
}

export component Title inherits Text {
    font-family: Theme.display-font;
    font-size: 28px;
    font-weight: 600;
    color: Theme.text;
}

export component Subtitle inherits Text {
    font-family: Theme.display-font;
    font-size: 20px;
    font-weight: 600;
    color: Theme.text;
}

export component BodyStrong inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Theme.text;
}

export component Caption inherits Text {
    font-size: 12px;
    color: Theme.text-secondary;
    wrap: word-wrap;
}

/// A section heading above a group of cards, as in Windows Settings.
export component SectionHeader inherits Text {
    font-size: 14px;
    font-weight: 600;
    color: Theme.text;
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-stroke;
}

/// A Windows Settings row: an icon, a title and description on the left, the control on the right.
export component SettingRow inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    background: Theme.card;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    // At least as tall as its content: a fixed min-height would let a squeezed page cut wrapped text off.
    min-height: Math.max(68px, row.min-height);
    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        if root.icon != "": Glyph {
            text: root.icon;
            font-size: 20px;
            width: 24px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.description != "": Caption {
                text: root.description;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                @children
            }
        }
    }
}

/// A Windows 11 toggle switch with the "On"/"Off" label on its left, as Settings shows it.
export component ToggleSwitch inherits Rectangle {
    // Clicking only reports the new state; the app sets `checked`.
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> show-label: true;
    callback toggled(bool);
    // A fixed width, so "On" and "Off" don't move what's beside it.
    width: show-label ? 88px : 40px;
    height: 32px;
    HorizontalLayout {
        spacing: 12px;
        alignment: end;
        if root.show-label: Text {
            text: root.checked ? "On" : "Off";
            color: root.enabled ? Theme.text : Theme.text-tertiary;
            vertical-alignment: center;
            horizontal-alignment: right;
            min-width: 24px;
        }
        track := Rectangle {
            width: 40px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: !root.enabled ? Theme.subtle-hover : root.checked ? (touch.pressed ? Theme.accent.darker(0.1) : touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (touch.has-hover ? Theme.subtle-hover : transparent);
            border-width: root.checked && root.enabled ? 0px : 1px;
            border-color: root.enabled ? Theme.text-secondary : Theme.text-tertiary;
            animate background { duration: 120ms; }
            knob := Rectangle {
                property <length> size: touch.pressed ? 14px : touch.has-hover ? 14px : 12px;
                width: touch.pressed ? 17px : self.size;
                height: self.size;
                border-radius: self.size / 2;
                x: root.checked ? parent.width - self.width - (20px - self.size) / 2 : (20px - self.size) / 2;
                y: (parent.height - self.height) / 2;
                background: !root.enabled ? Theme.text-tertiary : root.checked ? Theme.on-accent : Theme.text-secondary;
                animate x, width, height { duration: 160ms; easing: cubic-bezier(0.0, 0.0, 0.0, 1.0); }
            }
            touch := TouchArea {
                enabled: root.enabled;
                mouse-cursor: pointer;
                clicked => { root.toggled(!root.checked); }
            }
        }
    }
}

/// A plain button in Windows 11's style; `accent` makes it the filled accent button.
export component FluentButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> accent;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    min-width: 96px;
    border-radius: 4px;
    background: !root.enabled ? Theme.subtle-hover : root.accent ? (touch.pressed ? Theme.accent.darker(0.15) : touch.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (touch.pressed ? Theme.subtle-pressed : touch.has-hover ? Theme.control-hover : Theme.control);
    border-width: 1px;
    border-color: root.accent ? Theme.accent.darker(0.1) : Theme.control-stroke;
    animate background { duration: 90ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: center;
        if root.icon != "": Glyph {
            text: root.icon;
            font-size: 14px;
            color: label.color;
        }
        label := Text {
            text: root.text;
            vertical-alignment: center;
            color: !root.enabled ? Theme.text-tertiary : root.accent ? Theme.on-accent : Theme.text;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// A row of mutually exclusive choices (WinUI's SelectorBar / segmented control).
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected;
    callback changed(int);
    height: 32px;
    border-radius: 4px;
    background: Theme.control;
    border-width: 1px;
    border-color: Theme.control-stroke;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: 3px;
            background: i == root.selected ? Theme.accent : t.has-hover ? Theme.subtle-hover : transparent;
            animate background { duration: 120ms; }
            min-width: 112px;
            Text {
                text: option;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: i == root.selected ? Theme.on-accent : Theme.text;
            }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(i); }
            }
        }
    }
}

/// Windows 11's slider: a thin track, the accent fill and a round thumb with an inner dot that grows on hover.
export component FluentSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    in property <bool> enabled: true;
    callback changed(float);
    callback released(float);
    height: 32px;
    min-width: 160px;
    horizontal-stretch: 1;
    property <float> fraction: (root.value - root.minimum) / Math.max(0.0001, root.maximum - root.minimum);
    property <length> thumb-x: root.fraction * (root.width - 20px);
    track := Rectangle {
        x: 10px;
        width: root.width - 20px;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? (Theme.dark ? #ffffff8b : #00000072) : Theme.subtle-hover;
    }
    Rectangle {
        x: 10px;
        width: root.thumb-x;
        height: 4px;
        border-radius: 2px;
        background: root.enabled ? Theme.accent : Theme.text-tertiary;
    }
    thumb := Rectangle {
        x: root.thumb-x;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: Theme.dark ? #454545 : #ffffff;
        border-width: 1px;
        border-color: Theme.control-stroke;
        drop-shadow-blur: 2px;
        drop-shadow-color: #00000040;
        Rectangle {
            property <length> size: touch.pressed ? 10px : touch.has-hover ? 14px : 12px;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: root.enabled ? Theme.accent : Theme.text-tertiary;
            animate width, height { duration: 120ms; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        function set-from(x: length) {
            let raw = root.minimum + Math.clamp((x - 10px) / Math.max(1px, root.width - 20px), 0, 1) * (root.maximum - root.minimum);
            let stepped = Math.round(raw / root.step) * root.step;
            if (stepped != root.value) {
                root.value = stepped;
                root.changed(stepped);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                self.set-from(self.mouse-x);
            }
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                self.set-from(self.mouse-x);
            }
        }
        scroll-event(event) => {
            let delta = event.delta-y > 0 ? root.step : -root.step;
            let next = Math.clamp(root.value + delta, root.minimum, root.maximum);
            if (next != root.value) {
                root.value = next;
                root.changed(next);
                root.released(next);
            }
            accept
        }
    }
}

/// A color well: a rounded swatch with a hover ring.
export component Swatch inherits Rectangle {
    in property <color> fill;
    in property <bool> round: false;
    in property <bool> selected: false;
    callback clicked;
    callback right-clicked;
    border-radius: root.round ? self.width / 2 : 6px;
    background: root.fill;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.text : touch.has-hover ? Theme.text-secondary : Theme.control-stroke;
    animate border-color { duration: 100ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up && event.button == PointerEventButton.right) {
                root.right-clicked();
            }
        }
    }
    out property <bool> hovered: touch.has-hover;
}

/// A link-style text button.
export component LinkButton inherits Text {
    callback clicked;
    color: touch.has-hover ? Theme.accent.brighter(0.15) : Theme.accent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Windows 11's InfoBar, for errors and notices at the top of a page, and for what waits for a restart.
export component InfoBar inherits Rectangle {
    in property <string> message;
    in property <bool> critical;
    in property <bool> caution;
    in property <string> action;
    /// Shows a close button, which calls `closed`.
    in property <bool> closable;
    callback action-clicked;
    callback closed;
    background: root.critical ? Theme.critical-background : root.caution ? Theme.caution-background : Theme.card;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.card-stroke;
    HorizontalLayout {
        padding: 12px;
        padding-left: 16px;
        spacing: 12px;
        Glyph {
            text: root.critical ? Glyphs.error : root.caution ? Glyphs.warning : Glyphs.info;
            color: root.critical ? Theme.critical : root.caution ? Theme.caution : Theme.accent;
            width: 18px;
        }
        Text {
            text: root.message;
            wrap: word-wrap;
            color: Theme.text;
            font-weight: root.caution ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.action != "": FluentButton {
            text: root.action;
            clicked => { root.action-clicked(); }
        }
        if root.closable: Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 4px;
            background: close.pressed ? Theme.subtle-pressed : close.has-hover ? Theme.subtle-hover : transparent;
            Glyph {
                text: Glyphs.close;
                font-size: 12px;
                color: Theme.text-secondary;
            }
            close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.closed(); }
            }
        }
    }
}
